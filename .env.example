# Required for both local development and Docker Compose
# Generate strong secrets using: openssl rand -base64 32

# Database Configuration
POSTGRES_USER=friendmap
POSTGRES_PASSWORD=replace-with-strong-postgres-password
POSTGRES_DB=friendmap

# JWT Configuration
JWT_SECRET=replace-with-strong-jwt-secret-min-32-chars

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-redis-password

# Application Configuration
PORT=3000
NODE_ENV=development

# Directory where chat image attachments are stored (defaults to ./uploads)
# In Docker Compose this is set automatically to /app/uploads (a named volume).
# UPLOADS_DIR=

# Comma-separated list of allowed browser origins.
# Defaults to http://localhost:5173, http://127.0.0.1:5173, http://localhost:8080, http://127.0.0.1:8080
# CORS_ORIGINS=http://localhost:5173,http://friendmap.local

# Frontend Configuration
VITE_API_URL=http://localhost:3000

# Docker Compose Usage
# Copy this file to .env and fill in the secure values before running:
# docker compose up --build
